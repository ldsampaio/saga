# SAGA — ambiente de desenvolvimento
# Nunca commite o .env real.

# --- sistemas2 (UTFPR) ---
UPSTREAM_BASE_URL=https://sistemas2.utfpr.edu.br
UPSTREAM_LOGIN_URL=https://sistemas2.utfpr.edu.br/utfpr-auth/api/v1/
UPSTREAM_LOGOUT_URL=
UPSTREAM_SCAN_URL=
UPSTREAM_FLOW_TIMEOUT=15

# --- sessão local ---
SESSION_TTL_SECONDS=3600
SESSION_INACTIVITY_TTL_SECONDS=900
SESSION_COOKIE_NAME=saga_session
SESSION_COOKIE_SECURE=false
# Domínio compartilhado entre saga, sgoa e sgrf. Vazio = host-only.
SESSION_COOKIE_DOMAIN=
# Em desenvolvimento o saga gera .secret_key e .jwt_private_key.pem (gitignored).
# Em produção defina ambos.
SESSION_SECRET_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_KID=saga-1
JWT_ISSUER=saga

# --- heartbeat (falha fechada) ---
HEARTBEAT_TTL_SECONDS=60

# --- banco de identidade ---
DATABASE_URL=postgresql://sa:sa-dev@localhost:5432/sa

# --- portal ---
PORTAL_BASE_URL=http://localhost:8000
PORTAL_ALLOWED_REDIRECT_HOSTS=["localhost"]

# --- rate limit ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
